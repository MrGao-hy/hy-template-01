					"style": {
						"navigationStyle": "custom",
						"navigationBarTextStyle": "white",
						"disableScroll": true
					}
				}
			]
		}
	],
	"tabBar": {
		"color": "#7A7E83",
		"selectedColor": "#3cc51f",
		"borderStyle": "black",
		"backgroundColor": "@bgColor",
		"list": [
			// GENERATED BY UNI-PAGES, PLATFORM: H5
			{
				"pagePath": "pages/index/Index",
